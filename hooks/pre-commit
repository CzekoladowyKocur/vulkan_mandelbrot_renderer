#!/bin/sh

FILES=$(git diff --cached --name-only --diff-filter=ACMR -- 'src/*.cpp' 'src/*.mm' 'include/*.hpp')

[ -z "$FILES" ] && exit 0

echo "$FILES" | xargs clang-format --dry-run --Werror
FORMAT_STATUS=$?

if [ $FORMAT_STATUS -ne 0 ]; then
	echo "" >&2
	echo "pre-commit: formatting check failed. Fix with:" >&2
	echo "  clang-format -i $(echo $FILES | tr '\n' ' ')" >&2
	exit $FORMAT_STATUS
fi

COMPILE_DB_DIR=""
for CANDIDATE in build/ninja build/macos; do
	if [ -f "$CANDIDATE/compile_commands.json" ]; then
		COMPILE_DB_DIR=$CANDIDATE
		break
	fi
done

if [ -z "$COMPILE_DB_DIR" ]; then
	echo "pre-commit: no compile_commands.json found, skipping clang-tidy" >&2
	exit 0
fi

if ! command -v clang-tidy >/dev/null 2>&1; then
	echo "pre-commit: clang-tidy not found in PATH, skipping" >&2
	exit 0
fi

TIDY_ARGS=""
if [ "$(uname)" = "Darwin" ]; then
	TIDY_ARGS="--extra-arg=-isysroot$(xcrun --show-sdk-path) --extra-arg=-isystem/usr/local/include"
fi

TIDY_FILES=""
for FILE in $(echo "$FILES" | grep '\.cpp$'); do
	if grep -q "$FILE" "$COMPILE_DB_DIR/compile_commands.json"; then
		TIDY_FILES="$TIDY_FILES $FILE"
	fi
done

if [ -n "$TIDY_FILES" ]; then
	clang-tidy --quiet $TIDY_ARGS -p=$COMPILE_DB_DIR $TIDY_FILES
	TIDY_STATUS=$?
else
	TIDY_STATUS=0
fi

if [ $TIDY_STATUS -ne 0 ]; then
	echo "" >&2
	echo "pre-commit: clang-tidy check failed, fix the issues above" >&2
fi

exit $TIDY_STATUS
